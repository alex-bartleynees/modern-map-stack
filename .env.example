# LINZ Data Service key — for WFS downloads (parcels, buildings, addresses, titles)
# Get at: https://data.linz.govt.nz → sign in → API Keys
LINZ_KEY=

# Stats NZ / Koordinates key — for meshblocks and census SA2 downloads
# Get at: https://datafinder.stats.govt.nz/my/api/
KOORDINATES_KEY=

# Password for the postgis database, shared by martin and pg_featureserv.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
POSTGRES_PASSWORD=
